<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.saas.pricing</groupId>
    <artifactId>pricing-engine-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Enterprise Pricing Engine Parent</name>
    <description>Enterprise-grade plug-and-play generic pricing and rating engine library for SaaS</description>

    <modules>
        <module>pricing-engine-core</module>
        <module>pricing-engine-evaluator</module>
        <module>pricing-engine-metering</module>
        <module>pricing-engine-persistence</module>
        <module>pricing-engine-redis</module>
        <module>pricing-engine-spring-boot-starter</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring.boot.version>4.1.1</spring.boot.version>
        <junit.jupiter.version>5.11.4</junit.jupiter.version>
        <assertj.version>3.27.3</assertj.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <cyclonedx-maven-plugin.version>2.9.1</cyclonedx-maven-plugin.version>
        <!--
          H2 is a TEST-ONLY dependency: production runs on PostgreSQL. Pinned rather than inherited
          from the Spring Boot BOM because 2.4.x breaks the JDBC test fixture - ResourceDatabasePopulator
          hands H2 each CREATE TABLE as a text block, and 2.4 registers the inline CHECK constraints of
          such a block with an empty expression, so a constraint that plainly allows 'OPEN' rejects it.
          Re-pin (and re-run the persistence suite) when this moves.
        -->
        <h2.version>2.3.232</h2.version>
        <!--
          Tests carrying the "load" or "soak" JUnit tags are excluded from the ordinary build. They run for minutes
          and measure the machine as much as the code, so a shared CI box would turn a throughput
          number into noise. They are not excluded because they matter less - they are run
          deliberately, on quiet hardware, by clearing the property:

              mvn test -Dtest=PricingEngineLoadTest -Dsurefire.excludedGroups=

          The correctness assertions inside those classes still matter; what is withheld by default
          is the timing measurement, not the invariant.
        -->
        <surefire.excludedGroups>load,soak</surefire.excludedGroups>
        <!--
          Property-based testing. Generates the corner cases a hand-written example set never
          thought to include. See pricing-engine-core/pom.xml for why this engine needs it.
        -->
        <jqwik.version>1.10.1</jqwik.version>
        <!--
          Mutation testing. Answers a question coverage cannot: would these tests actually FAIL if
          the code were wrong? PIT mutates production bytecode (>= becomes >, a null check is
          deleted, a rounding mode is swapped) and reports every mutant the suite did not kill. A
          surviving mutant is a claim the test suite is making and not honouring. Not bound to the
          build: it is slow, and a number measured on a busy machine is not a gate. Run it
          deliberately - see the profile in docs/RESILIENCE_TESTING.md.
        -->
        <pitest.version>1.30.0</pitest.version>
        <!-- The JUnit 5 engine plugin is versioned independently of the PIT core. -->
        <pitest.junit5.version>1.2.3</pitest.junit5.version>
        <!--
          Testcontainers BOM. Imported explicitly because Maven does not resolve a BOM imported by
          an imported BOM, so the testcontainers-bom nested inside spring-boot-dependencies has no
          effect on this project's dependencyManagement. Pinned to the version the Boot 4 BOM
          declares; bump alongside Boot.
        -->
        <testcontainers.version>1.21.3</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal Modules -->
            <dependency>
                <groupId>com.saas.pricing</groupId>
                <artifactId>pricing-engine-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.saas.pricing</groupId>
                <artifactId>pricing-engine-evaluator</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.saas.pricing</groupId>
                <artifactId>pricing-engine-metering</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.saas.pricing</groupId>
                <artifactId>pricing-engine-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Test Dependencies -->
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>This project targets Java 25 or newer. Override with -Djava.version=&lt;N&gt; to build on another JDK.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx-maven-plugin.version}</version>
                <configuration>
                    <projectType>library</projectType>
                    <schemaVersion>1.6</schemaVersion>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                    <includeProvidedScope>true</includeProvidedScope>
                    <!--
                        Test dependencies are excluded by default. They are not shipped, so listing
                        them inflates the SBOM with a surface an adopter never has - and an SBOM
                        that overstates the attack surface is worse than none, because it trains
                        reviewers to skim.
                    -->
                    <includeTestScope>false</includeTestScope>
                    <outputFormat>all</outputFormat>
                    <outputName>bom</outputName>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <!--
                                Aggregate across all six modules rather than per-module: the point
                                of an SBOM is to answer "what did this release actually contain",
                                and an adopter pulls the starter, which transitively pulls the rest.
                            -->
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
